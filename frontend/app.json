{
  "expo": {
    "name": "Pramaan Digital Evidence System",
    "slug": "pramaan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pramaan",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#123F5E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123F5E"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pramaan to access camera for cryptographic evidence capture."
        }
      ]
    ]
  }
}
