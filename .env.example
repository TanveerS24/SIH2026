# Environment Configuration for Pramaan Platform
# Note: For Docker environment, hostnames change (e.g. postgres, minio)

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# PostgreSQL
POSTGRES_USER=pramaan
POSTGRES_PASSWORD=pramaan_dev_secret
POSTGRES_DB=pramaan_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pramaan:pramaan_dev_secret@localhost:5432/pramaan_db?schema=public

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evidence
MINIO_REGION=us-east-1

# JWT & Authentication
JWT_ACCESS_SECRET=pramaan_dev_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=pramaan_dev_jwt_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TOTP_ISSUER=Pramaan_NCRB

# Simulation / Feature Flags
SIMULATE_MALWARE_SCAN=true
SIMULATE_OCR_AI=true
SIMULATE_LEDGER=true
